## Copy this file to `.env` and populate the secrets. DO NOT commit real keys.
# Example:
# cp .env.template .env
# edit .env and fill values

# Polymarket private key: either set a path to a PEM file or paste the key inline (not recommended)
POLY_PRIVATE_KEY_PATH=
POLY_PRIVATE_KEY=

# Kalshi credentials
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Admin secret used to enable/disable live trading at runtime
ADMIN_SECRET=

# Ingest secret for the WS ingestion service
SPREAD_INGEST_SECRET=devsecret

# Runtime flags
LIVE_TRADING=false

# Execution sizing (USD)
DEFAULT_ORDER_USD=50
MAX_CHILD_ORDER_USD=50
ORDER_RATE_MS=250

# Backend port
BACKEND_PORT=8000

# Optional: path to a Python executable (defaults to .venv python)
PYTHON=/workspaces/Predication-Market/.venv/bin/python
