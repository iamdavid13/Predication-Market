# Polymarket WS URL (wss)
POLY_WS_URL=wss://api.polymarket.com/ws

# Local express server port
PORT=4002

# Spread engine URL that ws client will POST normalized trades to (e.g. backend /api/spread-ingest)
SPREAD_ENGINE_URL=http://localhost:8000/api/spread-ingest

# Optional secret header expected by the spread engine
SPREAD_INGEST_SECRET=change-me-secret

# WS client tuning
PING_INTERVAL_MS=20000
MIN_RECONNECT_MS=1000
MAX_RECONNECT_MS=60000
FLUSH_INTERVAL_MS=200
MAX_BUFFER=1000

# Optional DB for local persistence
DB_PATH=./data/polymarket_trades.db
LIVE_TRADING=false  # WARNING: set to true only after configuring credentials and safety checks
SPREAD_INGEST_SECRET=change-me-secret
ADMIN_SECRET=change-admin-secret
